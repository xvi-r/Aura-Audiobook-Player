{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Audiobooks",
  "version": "1.0.0",
  "identifier": "com.audiobooks.app",
  "build": {
    "beforeDevCommand": "python -m http.server 8000 --bind 127.0.0.1 --directory ../audiobook-web",
    "devUrl": "http://127.0.0.1:8000",
    "frontendDist": "../../audiobook-web"
  },
  "app": {
    "windows": [
      {
        "title": "Audiobooks",
        "width": 1400,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
